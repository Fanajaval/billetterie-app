{
  "expo": {
    "name": "Billetterie",
    "slug": "billetterie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser l'accès aux photos pour importer un visuel de billet."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser la caméra pour scanner et valider les billets Billetterie."
        }
      ],
      "expo-asset"
    ]
  }
}
